rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsArtwork(artworkId) {
      return signedIn()
        && get(/databases/$(database)/documents/artworks/$(artworkId)).data.ownerId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /artworks/{artworkId} {
      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid;
      allow read, delete: if signedIn()
                          && resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId;

      match /layers/{layerId} {
        allow read, create, update, delete: if ownsArtwork(artworkId);
      }

      match /photos/{photoId} {
        allow read, create, update, delete: if ownsArtwork(artworkId);
      }
    }
  }
}
