rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /artworks/{artworkId} {
      allow read, write: if request.auth != null;

      match /layers/{layerId} {
        allow read, write: if request.auth != null;
      }

      match /photos/{photoId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
