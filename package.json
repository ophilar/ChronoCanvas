{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "lint:rules": "eslint firestore.rules storage.rules",
    "lint": "npm run typecheck && npm run lint:rules",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "canvas": "^3.2.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "heic2any": "^0.0.4",
    "http-errors": "^2.0.1",
    "lucide-react": "^1.34.0",
    "motion": "^12.43.0",
    "multer": "^2.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.1",
    "react-easy-crop": "^6.2.3",
    "react-hot-toast": "^2.6.0",
    "react-router": "^8.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@webgpu/types": "^0.1.72",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
